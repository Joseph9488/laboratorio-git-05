<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="18" stylesheets="@../tema.css" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml" fx:controller="com.sistemasaludador.ui.saludo.SaludoController">
    <padding>
        <Insets bottom="32" left="40" right="40" top="32"/>
    </padding>

    <Label styleClass="titulo" text="Saludo"/>
    <Label fx:id="mensajeLabel" styleClass="mensaje-saludo" text=""/>
    <Button defaultButton="true" onAction="#onVolver" text="Volver"/>
</VBox>
